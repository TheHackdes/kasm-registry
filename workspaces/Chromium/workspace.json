{
  "description": "The Hackdes Image.",
  "docker_registry": "https://ghcr.io/",
  "image_src": "chromium.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Browser"
  ],
  "friendly_name": "The Hackdes Image",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "thehackdes/test-reg:main",
      "uncompressed_size_mb": 2170,
      "available_tags": [
        "main"
      ]
    }
  ]
}
